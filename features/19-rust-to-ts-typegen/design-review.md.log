            }
        })
        .sum();
    let full_rev_count = (total_circle_span / (2.0 * PI)).round() as i64;
    if full_rev_count <= 0 || (total_circle_span - full_rev_count as f64 * 2.0 * PI).abs() >= 1e-9 {
        return Err(TessellationError::TrimmedFaceUnsupported);
    }

