    13	pub async fn bind_listener(start_port: u16) -> Result<(tokio::net::TcpListener, u16), String> {
    14	    for i in 0..16 {
    15	        let port = start_port
    16	            .checked_add(i)
    17	            .ok_or_else(|| format!("port overflow: {start_port} + {i} exceeds u16 range"))?;
    18	        match tokio::net::TcpListener::bind(("127.0.0.1", port)).await {
    19	            Ok(listener) => return Ok((listener, port)),
    20	            Err(e) if e.kind() == std::io::ErrorKind::AddrInUse => continue,
    21	            Err(e) => return Err(format!("failed to bind port {port}: {e}")),
    22	        }
    23	    }
    24	    Err(format!(
    25	        "all 16 ports starting from {start_port} are in use"
    26	    ))
    27	}
