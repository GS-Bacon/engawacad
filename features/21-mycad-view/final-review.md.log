     9	pub(crate) async fn static_handler(uri: Uri) -> Response {
    10	    let path = uri.path().trim_start_matches('/');
    11	
    12	    let path = if path.is_empty() { "index.html" } else { path };
    13	
    14	    match WebAssets::get(path) {
    15	        Some(asset) => {
    16	            let mime = mime_guess::from_path(path).first_or_octet_stream();
    17	            if path == "index.html" {
    18	                let body = String::from_utf8_lossy(&asset.data).into_owned();
    19	                (
    20	                    StatusCode::OK,
    21	                    [(header::CONTENT_TYPE, "text/html; charset=utf-8")],
    22	                    body,
    23	                )
    24	                    .into_response()
    25	            } else {
    26	                (
    27	                    StatusCode::OK,
    28	                    [(header::CONTENT_TYPE, mime.as_ref())],
    29	                    asset.data.to_vec(),
    30	                )
    31	                    .into_response()
    32	            }
    33	        }
    34	        None => {
    35	            // SPA fallback: unknown paths serve index.html
    36	            match WebAssets::get("index.html") {
    37	                Some(html) => {
    38	                    Html(String::from_utf8_lossy(&html.data).into_owned()).into_response()
    39	                }
    40	                None => StatusCode::NOT_FOUND.into_response(),
    41	            }
    42	        }
    43	    }
    44	}

