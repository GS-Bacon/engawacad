    72	fn gen_ts() -> ExitCode {
    73	    use mycad_api::{ErrorResponse, MeshRequest};
    74	    use mycad_format::feature::EntityRef;
    75	    use mycad_format::Document;
    76	    use mycad_kernel::tessellation::TriangleMesh;
    77	    use ts_rs::TS;
    78	
    79	    let out_dir = workspace_root().join("web/src/generated");
    80	
    81	    if out_dir.exists() {
    82	        if let Err(e) = std::fs::remove_dir_all(&out_dir) {
    83	            eprintln!("Failed to clean output directory: {e}");
    84	            return ExitCode::FAILURE;
    85	        }
    86	    }
    87	    if let Err(e) = std::fs::create_dir_all(&out_dir) {
    88	        eprintln!("Failed to create output directory: {e}");
    89	        return ExitCode::FAILURE;
    90	    }
    91	
    92	    std::env::set_var("TS_RS_EXPORT_DIR", &out_dir);
    93	    let cfg = ts_rs::Config::from_env();
    94	
    95	    type ExportFn = Box<dyn FnOnce(&ts_rs::Config) -> Result<(), ts_rs::ExportError>>;
    96	    let roots: Vec<(&str, ExportFn)> = vec![
    97	        ("Document", Box::new(Document::export_all)),
    98	        ("EntityRef", Box::new(EntityRef::export_all)),
    99	        ("TriangleMesh", Box::new(TriangleMesh::export_all)),
   100	        ("MeshRequest", Box::new(MeshRequest::export_all)),
   101	        ("ErrorResponse", Box::new(ErrorResponse::export_all)),
   102	    ];
   103	
   104	    for (name, export_fn) in roots {
   105	        println!("Exporting {name}...");
   106	        if let Err(e) = export_fn(&cfg) {
   107	            eprintln!("Failed to export {name}: {e}");
   108	            return ExitCode::FAILURE;
   109	        }
   110	    }
   111	
   112	    println!("TypeScript types exported to {}", out_dir.display());
   113	    ExitCode::SUCCESS
   114	}
