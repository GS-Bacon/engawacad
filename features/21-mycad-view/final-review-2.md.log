   220	fn which(name: &str) -> Option<PathBuf> {
   221	    let paths = std::env::var("PATH").ok()?;
   222	    for dir in std::env::split_paths(&paths) {
   223	        let candidate = dir.join(name);
   224	        if candidate.is_file() {
   225	            return Some(candidate);
   226	        }
   227	    }
   228	    None
   229	}
