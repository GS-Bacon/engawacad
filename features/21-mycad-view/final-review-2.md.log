   138	fn extract_script_src(html: &str) -> String {
   139	    for line in html.lines() {
   140	        if line.contains("script") && line.contains("src=") {
   141	            if let Some(start) = line.find("src=\"") {
   142	                let rest = &line[start + 5..];
   143	                if let Some(end) = rest.find('"') {
   144	                    return rest[..end].to_string();
   145	                }
   146	            }
   147	        }
   148	    }
   149	    String::new()
   150	}

