   116	fn ci() -> ExitCode {
   117	    let Some(_node) = which("node") else {
   118	        eprintln!("FAILED: Node.js (>=20) and npm are required for CI.");
   119	        eprintln!("Install from https://nodejs.org/ or via nvm, then re-run `cargo xtask ci`.");
   120	        return ExitCode::FAILURE;
   121	    };
   122	
   123	    // Web build first so cargo steps embed real assets
   124	    println!("\n=== Building web frontend ===");
   125	    if web() != ExitCode::SUCCESS {
   126	        eprintln!("FAILED: Web frontend build");
   127	        return ExitCode::FAILURE;
   128	    }
   129	
   130	    let cargo_steps: &[(&str, &[&str])] = &[
   131	        (
   132	            "Checking formatting",
   133	            &["cargo", "fmt", "--all", "--", "--check"],
   134	        ),
   135	        (
   136	            "Running clippy",
   137	            &["cargo", "clippy", "--workspace", "--", "-D", "warnings"],
   138	        ),
   139	        ("Running tests", &["cargo", "test", "--workspace"]),
   140	        ("Building", &["cargo", "build", "--workspace"]),
   141	    ];
   142	
   143	    for (label, cmd) in cargo_steps {
   144	        println!("\n=== {label} ===");
   145	        let status = Command::new(cmd[0])
   146	            .args(&cmd[1..])
   147	            .status()
   148	            .expect("failed to execute command");
   149	
   150	        if !status.success() {
   151	            eprintln!("FAILED: {label}");
   152	            return ExitCode::FAILURE;
   153	        }
   154	    }
   155	
   156	    println!("\n=== Checking TS drift ===");
   157	    let tracked = Command::new("git")
   158	        .args(["ls-files", "web/src/generated/"])
   159	        .output()
   160	        .expect("failed to run git ls-files");
   161	    if tracked.stdout.is_empty() {
   162	        println!("No committed TS files found — skipping drift check (run `cargo xtask gen-ts` and commit the results).");
   163	    } else {
   164	        let output = Command::new("git")
   165	            .args([
   166	                "status",
   167	                "--porcelain",
   168	                "--untracked-files=all",
   169	                "--",
   170	                "web/src/generated/",
   171	            ])
   172	            .output()
   173	            .expect("failed to run git status");
   174	
   175	        let stdout = String::from_utf8_lossy(&output.stdout);
   176	        if !stdout.trim().is_empty() {
   177	            eprintln!("FAILED: TypeScript types are out of sync with committed versions");
   178	            eprintln!("Run `cargo xtask gen-ts` and commit the results.");
   179	            eprintln!("Drift detected:\n{stdout}");
   180	            return ExitCode::FAILURE;
   181	        }
   182	    }
   183	
   184	    // Release verification: ensure release build embeds real assets
   185	    println!("\n=== Release verification ===");
   186	    println!("Building release binary...");
   187	    let status = Command::new("cargo")
   188	        .args(["build", "-p", "mycad-cli", "--release"])
   189	        .status()
   190	        .expect("failed to execute cargo build --release");
   191	    if !status.success() {
   192	        eprintln!("FAILED: Release build");
   193	        return ExitCode::FAILURE;
   194	    }
   195	
   196	    println!("Running release smoke test...");
   197	    let status = Command::new("cargo")
   198	        .args(["test", "-p", "mycad-api", "--release", "static_assets"])
   199	        .status()
   200	        .expect("failed to execute release smoke test");
   201	    if !status.success() {
   202	        eprintln!("FAILED: Release smoke test");
   203	        return ExitCode::FAILURE;
   204	    }
   205	
   206	    println!("\n=== All CI checks passed ===");
   207	    ExitCode::SUCCESS
   208	}
