    18	#[derive(Subcommand)]
    19	enum Commands {
    20	    /// Convert a .mycad file to STL
    21	    Export {
    22	        /// Input .mycad file
    23	        input: PathBuf,
    24	        /// Output STL file
    25	        #[arg(short, long)]
    26	        output: PathBuf,
    27	        /// Number of angular segments for curved surfaces (default: 32)
    28	        #[arg(long)]
    29	        segments: Option<usize>,
    30	    },
    31	    /// Start a local server and open the model in a browser
    32	    View {
    33	        /// Input .mycad file
    34	        input: PathBuf,
    35	        /// Port to listen on (default: 7878)
    36	        #[arg(long, default_value_t = view::DEFAULT_PORT)]
    37	        port: u16,
    38	    },
    39	}
    40	
    41	fn main() {
    42	    let cli = Cli::parse();
    43	    match cli.command {
    44	        Commands::Export {
    45	            input,
    46	            output,
    47	            segments,
    48	        } => {
    49	            if let Err(msg) = run_export(&input, &output, segments) {
    50	                eprintln!("error: {msg}");
    51	                process::exit(1);
    52	            }
    53	        }
    54	        Commands::View { input, port } => {
    55	            if let Err(msg) = view::run_view(&input, port) {
    56	                eprintln!("error: {msg}");
    57	                process::exit(1);
    58	            }
    59	        }
    60	    }
    61	}
    62	
    63	fn run_export(
    64	    input: &std::path::Path,
    65	    output: &std::path::Path,
    66	    segments: Option<usize>,
    67	) -> Result<(), String> {
    68	    let doc = Document::from_path(input)
    69	        .map_err(|e| format!("failed to read {}: {e}", input.display()))?;
    70	    let mut gen = IdGenerator::new(0);
    71	    let solid = build_solid_from_features(&doc.root_component.features, &mut gen)
    72	        .map_err(|e| format!("failed to build solid: {e}"))?;
    73	    let opts = match segments {
    74	        Some(n) => TessellationOptions::new(n, 1),
    75	        None => TessellationOptions::default(),
    76	    };
    77	    let mesh =
    78	        tessellate_solid_with(&solid, &opts).map_err(|e| format!("failed to tessellate: {e}"))?;
    79	    let stl = to_ascii_stl(&mesh, "model");
    80	    std::fs::write(output, stl)
    81	        .map_err(|e| format!("failed to write {}: {e}", output.display()))?;
    82	    Ok(())
    83	}

