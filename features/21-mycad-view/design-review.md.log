t doc2 = Document::from_yaml(&yaml).unwrap();\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7661:   141\\t        assert_eq!(doc.to_yaml().unwrap(), doc2.to_yaml().unwrap());\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7664:   144\\t    /// T08: TS derive 追加後も .mycad fixture の YAML 表現が不変であること。\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7681:   161\\t            let yaml1 = doc.to_yaml().unwrap();\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7682:   162\\t            let doc2 = Document::from_yaml(&yaml1)\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7683:   163\\t                .unwrap_or_else(|e| panic!(\\\"failed to parse roundtrip YAML for {:?}: {e}\\\", path));\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7684:   164\\t            let yaml2 = doc2.to_yaml().unwrap();\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7686:   166\\t                yaml1,\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7687:   167\\t                yaml2,\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7688:   168\\t                \\\"YAML roundtrip mismatch for {}\\\",\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7693:   173\\t        // Golden comparison: simple_box.mycad canonical YAML must be byte-identical\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7696:   176\\t        let yaml = doc.to_yaml().unwrap();\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7697:   177\\t        let golden = \\\"version: 0.1.0\\\\nroot_component:\\\\n  name: Simple Box\\\\n  features:\\\\n  - type: create_box\\\\n    id: box_1\\\\n    width: 10.0\\\\n    height: 20.0\\\\n    depth: 30.0\\\\n\\\";\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7698:   178\\t        assert_eq!(yaml, golden, \\\"simple_box.mycad golden YAML mismatch\\\");\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7739:   245\\t    fn t03_triangle_mesh() {\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7750:   256\\t    fn t04_document_and_component() {\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7773:   279\\t    fn t05_component_ref_is_string() {\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7790:   296\\t    fn t09_api_transport_dto() {\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7809:   315\\t    fn t06_gen_ts_produces_all_files() {\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7831:   337\\t    fn t01_determinism_100_runs() {\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7869:+    # --output-last-message で最終メッセージ(verdict YAML)のみを結果ファイルに書く。\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7905:    finding: \\\"TS drift check は tracked な `web/src/generated/*` が 1 つも無いと丸ごと skip するが、現状その生成物自体が untracked のままなので、T06/T07 の成果物なしで CI が green になってしまう。\\\"\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7911:    finding: \\\"`test_ts_derive_backward_compat` の exact golden は `simple_box.mycad` だけで、`cylinder.mycad` と `assembly.mycad` は変更後 YAML の roundtrip (`yaml1 == yaml2`) しか見ていない。これでは T08 の『examples/*.mycad の wire YAML が不変』を満たせず、他 fixture の serde 回帰を取りこぼす。\\\"\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7912:    suggestion: \\\"各 example について `to_yaml()` を fixture 本文または個別 golden と比較し、全 `.mycad` で byte-identical を固定する。\\\"\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7917:    finding: \\\"`t06_gen_ts_produces_all_files` は `gen_ts()` / `cargo xtask gen-ts` を通さず temp dir への直接 export しか確認していない。`workspace_root()`、`web/src/generated` の掃除、実 CLI 経路が壊れてもこのテスト群では検出できない。\\\"\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7934:    finding: \\\"TS drift check は tracked な `web/src/generated/*` が 1 つも無いと丸ごと skip するが、現状その生成物自体が untracked のままなので、T06/T07 の成果物なしで CI が green になってしまう。\\\"\\nfeatures/19-rust-to-ts-typegen/final-review.md.log:7940:    finding: \\\"`test_ts_derive_backward_compat` の exact golden は `simple_box.mycad` だけで、`cylinder.mycad` と `assembly.mycad` は変更後 YAML の roundtrip (`yaml1 == yaml2`) しか見ていない。これでは T08 の『examples/*.mycad の