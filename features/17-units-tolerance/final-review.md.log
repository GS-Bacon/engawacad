ate(`document.rs` の `test_assembly_roundtrip` 等)で既に担保済み。API 層での重複は規約「テストは所有クレートに置く」に反するため追加しない。API 層は HTTP 契約(status・JSON 形・決定性・cylinder 経路疎通)に集中する。\\nfeatures/18-api-skeleton/design-review-2.md:2137:./crates/mycad-kernel/src/primitives/cylinder.rs:180:    /// T03: Euler–Poincaré formula V - E + F = 2(S - H), S=1, H=0 → 2.\\nfeatures/18-api-skeleton/design-review-2.md:2316:    /// Serialize to YAML string.\\nfeatures/18-api-skeleton/design-review-2.md:2317:    pub fn to_yaml(&self) -> Result<String, serde_yaml::Error> {\\nfeatures/18-api-skeleton/design-review-2.md:2318:        serde_yaml::to_string(self)\\nfeatures/18-api-skeleton/design-review-2.md:2321:    /// Deserialize from YAML string.\\nfeatures/18-api-skeleton/design-review-2.md:2322:    pub fn from_yaml(yaml: &str) -> Result<Self, serde_yaml::Error> {\\nfeatures/18-api-skeleton/design-review-2.md:2323:        serde_yaml::from_str(yaml)\\nfeatures/18-api-skeleton/design-review-2.md:2333:        let doc = Self::from_yaml(&content)?;\\nfeatures/18-api-skeleton/design-review-2.md:2346:    fn test_roundtrip_yaml() {\\nfeatures/18-api-skeleton/design-review-2.md:2354:        let yaml = doc.to_yaml().unwrap();\\nfeatures/18-api-skeleton/design-review-2.md:2355:        let doc2 = Document::from_yaml(&yaml).unwrap();\\nfeatures/18-api-skeleton/design-review-2.md:2366:    fn test_yaml_is_deterministic() {\\nfeatures/18-api-skeleton/design-review-2.md:2375:        let yaml1 = doc.to_yaml().unwrap();\\nfeatures/18-api-skeleton/design-review-2.md:2376:        let yaml2 = doc.to_yaml().unwrap();\\nfeatures/18-api-skeleton/design-review-2.md:2377:        assert_eq!(yaml1, yaml2, \\\"YAML serialization must be deterministic\\\");\\nfeatures/18-api-skeleton/design-review-2.md:2407:    fn test_assembly_roundtrip() {\\nfeatures/18-api-skeleton/design-review-2.md:2428:        // Roundtrip: serialize then deserialize yields the same YAML\\nfeatures/18-api-skeleton/design-review-2.md:2429:        let yaml = doc.to_yaml().unwrap