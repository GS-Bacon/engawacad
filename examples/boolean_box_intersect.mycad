schema_version: 1
version: "0.1.0"
root_component:
  name: "Boolean Box Intersect"
  features:
    - type: create_box
      id: box_a
      width: 4.0
      height: 4.0
      depth: 2.0
    - type: create_cylinder
      id: cyl_b
      radius: 1.5
      height: 6.0
      origin: [0.0, 0.0, -3.0]
    - type: intersect
      id: int1
      target: box_a
      tool: cyl_b
