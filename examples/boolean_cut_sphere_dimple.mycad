schema_version: 1
version: "0.1.0"
root_component:
  name: "Box Cut Sphere (Dimple)"
  features:
    - type: create_box
      id: box1
      width: 10.0
      height: 10.0
      depth: 10.0
    - type: create_sphere
      id: sphere1
      radius: 3.0
    - type: cut
      id: cut1
      target: box1
      tool: sphere1
