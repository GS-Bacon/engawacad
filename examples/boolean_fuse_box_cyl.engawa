schema_version: 1
version: "0.1.0"
root_component:
  name: "Boolean Fuse Box + Cylinder"
  features:
    - type: create_box
      id: box1
      width: 10.0
      height: 10.0
      depth: 10.0
    - type: create_cylinder
      id: cyl1
      radius: 2.0
      height: 15.0
      origin: [0.0, 0.0, -7.5]
    - type: fuse
      id: result
      target: box1
      tool: cyl1
