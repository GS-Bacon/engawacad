schema_version: 1
version: "0.1.0"
root_component:
  name: "Boolean Box Void Shell"
  features:
    - type: create_box
      id: outer
      width: 6.0
      height: 6.0
      depth: 6.0
    - type: create_sphere
      id: inner
      radius: 2.0
      center: [0.0, 0.0, 3.5]
    - type: cut
      id: cut1
      target: outer
      tool: inner
