schema_version: 1
version: "0.1.0"
root_component:
  name: "Two Bodies"
  features:
    - type: create_sketch
      id: sketch_a
      plane: xy
      profile:
        - kind: line
          id: sa1
          from:
          - 0.0
          - 0.0
          to:
          - 10.0
          - 0.0
        - kind: line
          id: sa2
          from:
          - 10.0
          - 0.0
          to:
          - 10.0
          - 10.0
        - kind: line
          id: sa3
          from:
          - 10.0
          - 10.0
          to:
          - 0.0
          - 10.0
        - kind: line
          id: sa4
          from:
          - 0.0
          - 10.0
          to:
          - 0.0
          - 0.0
    - type: create_sketch
      id: sketch_b
      plane: xy
      profile:
        - kind: line
          id: sb1
          from:
          - 50.0
          - 0.0
          to:
          - 60.0
          - 0.0
        - kind: line
          id: sb2
          from:
          - 60.0
          - 0.0
          to:
          - 60.0
          - 10.0
        - kind: line
          id: sb3
          from:
          - 60.0
          - 10.0
          to:
          - 50.0
          - 10.0
        - kind: line
          id: sb4
          from:
          - 50.0
          - 10.0
          to:
          - 50.0
          - 0.0
    - type: extrude
      id: body_a
      sketch: sketch_a
      depth: 10.0
    - type: extrude
      id: body_b
      sketch: sketch_b
      depth: 10.0
