schema_version: 1
version: "0.1.0"
root_component:
  name: "Boolean Box Fuse"
  features:
    - type: create_box
      id: box_a
      width: 2.0
      height: 2.0
      depth: 2.0
    - type: create_box
      id: box_b
      width: 2.0
      height: 2.0
      depth: 2.0
    - type: fuse
      id: fuse1
      target: box_a
      tool: box_b
