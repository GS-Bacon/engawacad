schema_version: 2
version: "0.1.0"
root_component:
  name: "Sketch Fillet Example (Phase 10 #296)"
  features:
    # 10x5 rectangle on XY plane
    - type: create_sketch
      id: sketch_0
      plane: xy
      offset: 0.0
      profile:
        - kind: line
          id: l1
          from: [0.0, 0.0]
          to: [10.0, 0.0]
        - kind: line
          id: l2
          from: [10.0, 0.0]
          to: [10.0, 5.0]
        - kind: line
          id: l3
          from: [10.0, 5.0]
          to: [0.0, 5.0]
        - kind: line
          id: l4
          from: [0.0, 5.0]
          to: [0.0, 0.0]
    # Round the corner at l1/l2 with radius 1.0
    - type: sketch_fillet
      id: fillet_1
      sketch: sketch_0
      elem1_id: l1
      elem2_id: l2
      radius: 1.0
    # Extrude the filleted profile into a solid
    - type: extrude
      id: extrude_1
      sketch: sketch_0
      depth: 3.0
