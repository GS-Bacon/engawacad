schema_version: 1
version: "0.1.0"
root_component:
  name: "Boolean Box Cut"
  features:
    - type: create_box
      id: target
      width: 4.0
      height: 4.0
      depth: 4.0
    - type: create_cylinder
      id: tool
      radius: 1.0
      height: 6.0
      origin: [0.0, 0.0, -3.0]
    - type: cut
      id: cut1
      target: target
      tool: tool
